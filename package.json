{
  "name": "crap-score-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local function risk, coverage evidence and change review for TypeScript and Swift",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "crap-mcp": "./dist/server.js",
    "crap-coverage": "./dist/record.js",
    "crap-issues": "./dist/issue-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write src scripts test",
    "test": "node --test test/*.test.ts",
    "coverage": "node src/record.ts coverage/lcov.info -- node scripts/unit-coverage.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "check": "npm run lint && npm run build && node dist/project-check.js \"Repository self-check\" && npm run dogfood",
    "prove": "npm run build && node scripts/prove.mjs",
    "dashboard": "npm run build && node scripts/dashboard.mjs",
    "summary": "npm run build --silent && node scripts/summary.mjs",
    "install:machine": "bash scripts/install-machine.sh",
    "machine": "npm run build && node dist/machine.js",
    "prove:packs": "npm run build && node scripts/prove-packs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oxlint/plugins": "1.92.0",
    "@resvg/resvg-js": "2.6.2",
    "jsonc-parser": "3.3.1",
    "oxlint": "1.92.0",
    "web-tree-sitter": "0.27.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "27.0.0",
    "@types/node": "24.19.2",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
